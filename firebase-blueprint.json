{
  "entities": {
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Poruka u internom ribičkom chatu uživo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deviceId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "createdAt": { "type": "number" },
        "readBy": { "type": "array" }
      },
      "required": ["id", "deviceId", "userName", "text", "createdAt"]
    },
    "ChatTyping": {
      "title": "ChatTyping",
      "description": "Status korisnika koji trenutno piše u chatu",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "userName": { "type": "string" },
        "isTyping": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["deviceId", "userName", "isTyping", "updatedAt"]
    },
    "License": {
      "title": "License",
      "description": "Zapis o korisničkoj licenci i ovlastima za LiveChat",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string" },
        "activationKey": { "type": "string" },
        "userName": { "type": "string" },
        "status": { "type": "string" },
        "chatEnabled": { "type": "boolean" },
        "createdAt": { "type": "string" },
        "lastSeenAt": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["deviceId", "userName", "status"]
    },
    "CatchStats": {
      "title": "CatchStats",
      "description": "Evidencija ulova po vrstama ribe za ribolovce (Sikac, Krasni, Domo, Mališa)",
      "type": "object",
      "properties": {
        "counts": { "type": "object" },
        "anglerDevices": { "type": "object" },
        "history": { "type": "array" },
        "updatedAt": { "type": "number" }
      },
      "required": ["counts", "updatedAt"]
    },
    "WaterStation": {
      "title": "WaterStation",
      "description": "Sinkronizirani službeni podaci o vodostaju, temperaturi vode, zraka i tlaku za Aljmaš i Bogojevo",
      "type": "object",
      "properties": {
        "waterLevelCm": { "type": "number" },
        "waterTempC": { "type": "number" },
        "airTempC": { "type": "number" },
        "airPressureHpa": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["waterLevelCm", "waterTempC", "updatedAt"]
    },
    "OtaBundle": {
      "title": "OtaBundle",
      "description": "Live Web OTA paket koda za automatsku nadogradnju aplikacije bez APK instalacije",
      "type": "object",
      "properties": {
        "version": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["version"]
    }
  },
  "firestore": {
    "/chat_messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Kolekcija svih poruka u LiveChatu"
    },
    "/chat_typing/{deviceId}": {
      "schema": { "$ref": "#/entities/ChatTyping" },
      "description": "Status tipkanja pojedinog korisnika"
    },
    "/licenses/{deviceId}": {
      "schema": { "$ref": "#/entities/License" },
      "description": "Licence i prava pristupa korisnika"
    },
    "/catch_stats/{docId}": {
      "schema": { "$ref": "#/entities/CatchStats" },
      "description": "Zajednička tablica evidencije ulova po vrstama ribe"
    },
    "/water_stations/{stationId}": {
      "schema": { "$ref": "#/entities/WaterStation" },
      "description": "Sinkronizirani hidrometeo podaci za Aljmaš i Bogojevo"
    },
    "/ota_bundle/{chunkId}": {
      "schema": { "$ref": "#/entities/OtaBundle" },
      "description": "Dijelovi (chunks) kompiliranog Live Web OTA paketa"
    }
  }
}
