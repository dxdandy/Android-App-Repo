rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Kolekcija poruka u chatu
    match /chat_messages/{messageId} {
      allow read, write: if true;
    }

    // Status tipkanja u stvarnom vremenu
    match /chat_typing/{deviceId} {
      allow read, write: if true;
    }

    // Licence i autorizacije
    match /licenses/{deviceId} {
      allow read, write: if true;
    }

    // Informacije o najnovijoj verziji za Live Web Ažuriranja
    match /app_updates/{docId} {
      allow read, write: if true;
    }

    // Zajednička evidencija ulova po vrstama ribe (Sikac, Krasni, Domo, Mališa)
    match /catch_stats/{docId} {
      allow read, write: if true;
    }

    // Sinkronizirani hidrometeo podaci (vodostaj, temp vode, temp zraka, tlak) za Aljmaš i Bogojevo
    match /water_stations/{stationId} {
      allow read, write: if true;
    }

    // Live Web OTA kompilirani paketi za nadogradnju koda bez instalacije APK-a
    match /ota_bundle/{chunkId} {
      allow read, write: if true;
    }
  }
}
